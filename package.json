{
  "name": "@pagopa/selfcare-common-frontend",
  "description": "Shared React components for the pagopa selfcare project",
  "version": "3.0.0",
  "license": "MIT",
  "repository": "https://github.com/pagopa/selfcare-common-frontend",
  "author": "https://www.pagopa.gov.it",
  "private": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": [
    "lib/consentManagementConfigure.js",
    "lib/**/*.css"
  ],
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/base": "^5.0.0-beta.70",
    "@mui/icons-material": "^5.14.1",
    "@mui/lab": "^5.0.0-alpha.137",
    "@mui/material": "^5.14.1",
    "@mui/system": "^5.14.1",
    "@pagopa/mui-italia": "^2.7.0",
    "@pagopa/ts-commons": "^13.1.2",
    "@reduxjs/toolkit": "^2.9.0",
    "async": "3.2.4",
    "fp-ts": "^2.11.5",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "io-ts": "^2.2.16",
    "lodash": "^4.18.1",
    "mixpanel-browser": "^2.74.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.1.2",
    "react-md-spinner": "^1.0.0",
    "react-redux": "^7.2.6",
    "react-router": "^7",
    "redux-logger": "^3.0.6"
  },
  "scripts": {
    "clean": "npm-run-all clean:*",
    "start": "vite",
    "cpDistStatic": "copyfiles -u 2 src/lib/index.css src/lib/utils/fixSwagger20ArraySchemaDef.js dist && copyfiles package.json README.md CHANGELOG.md dist",
    "dist": "tsc -p tsconfigDist.json && yarn cpDistStatic",
    "clean:dist": "rimraf dist",
    "check:package": "yarn clean:dist && yarn dist && node scripts/check-package.mjs",
    "clean:package-check": "rimraf .package-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean:coverage": "rimraf coverage",
    "lint-autofix": "eslint . --fix",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "prettify": "prettier --write \"./**/*.{ts,tsx}\"",
    "version": "auto-changelog -p --config .auto-changelog.json && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pagopa/openapi-codegen-ts": "^14.2.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash": "^4.14.172",
    "@types/mixpanel-browser": "^2.38.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-redux": "^7.1.33",
    "@types/redux-logger": "^3.0.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "auto-changelog": "^2.3.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^9.0.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "mkdirp": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "regex-replace": "^2.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.1.5",
    "vite-plugin-html": "^3.2.2",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "@types/react": "18.3.16"
  }
}
